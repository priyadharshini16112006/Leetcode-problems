class Solution {
    public int reverseBits(int n) {
        int ans=0;
        int bit;
        for(int i=0;i<32;i++){
            bit=n&1;              // n's last bit
            ans=ans<<1;           //space for ans
            ans=ans|bit;         // adding bit
            n=n>>1;              // move n to next bit
    
        }
        return ans;
    }

}
